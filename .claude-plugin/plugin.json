{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "inaturalist-mcp-server",
  "version": "0.2.2",
  "description": "Search wildlife sightings, read identification threads, rank species by area, chart phenology, and find look-alike taxa from iNaturalist via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/inaturalist-mcp-server#readme",
  "repository": "https://github.com/cyanheads/inaturalist-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "inaturalist", "biodiversity", "citizen-science", "species", "wildlife"],
  "mcpServers": {
    "inaturalist-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/inaturalist-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "INATURALIST_CLAMP_LIMITS": "${user_config.clamp_limits}"
      }
    }
  },
  "userConfig": {
    "clamp_limits": {
      "type": "string",
      "title": "Clamp read limits",
      "description": "Clamp oversized read limits and defer oversized by-id batches. Set false for strict rejection.",
      "default": ""
    }
  }
}
